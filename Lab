
def seconds_to_hms(seconds):
    h = seconds // 3600
    m = (seconds % 3600) // 60
    s = seconds % 60
    return f"{h:02}:{m:02}:{s:02}"


def celsius_to_fahrenheit(celsius):
    return round(celsius * 9 / 5 + 32)


def split_evenly(total, people):
    return total // people, total % people


def initials(full_name):
    names = full_name.split()
    result = ""
    i = 0

    while i < len(names):
        result += names[i][0].upper()
        i += 1

    return result


def is_palindrome_word(word):
    word = word.strip().lower()
    return word == word[::-1]


def mask_email(email):
    i = email.index("@")
    return email[0] + "*" * (i - 1) + email[i:]


def middle(values):
    n = len(values)
    if n % 2 == 1:
        return values[n // 2:n // 2 + 1]
    return values[n // 2 - 1:n // 2 + 1]


def rotate_left(values, k):
    k = k % len(values)
    return values[k:] + values[:k]


def fib_list(n):
    result = []
    a = 0
    b = 1

    while len(result) < n:
        result.append(a)
        a, b = b, a + b

    return result


def collatz_steps(n):
    steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n // 2
        else:
            n = 3 * n + 1
        steps += 1

    return steps
